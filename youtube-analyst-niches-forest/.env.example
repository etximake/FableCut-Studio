# ==========================================
# CẤU HÌNH NHÀ CUNG CẤP AI (AI PROVIDER)
# ==========================================

# 1. Custom 3rd-party Provider (ai-box.vn, openrouter, v.v.):
DEFAULT_AI_PROVIDER=custom
OPENAI_API_KEY=your_custom_api_key_here
OPENAI_BASE_URL=https://api.ai-box.vn/v1

# 2. Hoặc nếu dùng OpenAI chính hãng:
# DEFAULT_AI_PROVIDER=openai
# OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OPENAI_BASE_URL=

# 3. Hoặc nếu dùng Google Gemini:
# DEFAULT_AI_PROVIDER=gemini
# GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ==========================================
# CẤU HÌNH MÔ HÌNH (MODELS)
# ==========================================
# Model đọc ảnh Vision cho Chặng 1 (Smart Contact Sheet)
DEFAULT_VISION_MODEL=gpt-4o-mini
# Model biên soạn lời bình cho Chặng 2 (Commentary Scriptwriter)
DEFAULT_TEXT_MODEL=gpt-4o-mini

# Provider dự phòng (tùy chọn)
# BACKUP_AI_PROVIDER=gemini
# BACKUP_GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# BACKUP_VISION_MODEL=gemini-2.0-flash
# BACKUP_TEXT_MODEL=gemini-2.0-flash

# ==========================================
# CẤU HÌNH HỆ THỐNG
# ==========================================
HOST=0.0.0.0
PORT=8000
PREFERRED_LANGUAGE=vi
DEFAULT_COMMENTARY_SKILL=curiosity-explainer
