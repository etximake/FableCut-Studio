{
  "template_id": "hazard-rescue",
  "version": "1.1.0",
  "name_en": "Hazard & Rescue",
  "name_vi": "Cứu hộ móng & Xử lý sự cố",
  "purpose": "High retention problem-solving. Emergency -> Diagnosis -> Surgical Treatment -> Instant Relief.",
  "use_when": [
    "Severe hoof abscess, overgrown hoof, limping cattle or horse",
    "Field machine breakdown, jammed gear, emergency repair",
    "Animal rescue or distress requiring hands-on craft"
  ],
  "avoid_when": [
    "Routine harmless maintenance with no drama",
    "Purely informational tutorials"
  ],
  "best_for_niches": [
    "farrier / hoof care",
    "large animal veterinary",
    "farm machinery breakdown / emergency fix"
  ],
  "canvas": {
    "aspect": "9:16",
    "width": 1080,
    "height": 1920,
    "fps": 30
  },
  "structure": {
    "beats": [
      {
        "beat": "EMERGENCY",
        "share": "0-3s",
        "target_seconds": [
          0,
          3
        ],
        "note": "Immediate distress shot. High tension alert text (max 3 words)."
      },
      {
        "beat": "DIAGNOSIS",
        "share": "3-9s",
        "target_seconds": [
          3,
          9
        ],
        "note": "Farrier/Technician examines the affected area, pinpoints abscess or clog."
      },
      {
        "beat": "TREATMENT",
        "share": "9-24s",
        "target_seconds": [
          9,
          24
        ],
        "note": "Main surgical cutting, draining pus, cleaning, applying medication & protective pad."
      },
      {
        "beat": "RELIEF",
        "share": "24-31s",
        "target_seconds": [
          24,
          31
        ],
        "note": "The animal walks pain-free or the tractor hums back to life. Heartwarming payoff."
      }
    ],
    "target_total_seconds": [
      30,
      45
    ]
  },
  "text_defaults": {
    "font": "Anton",
    "font_size": 84,
    "style": "IMPACT_RED",
    "bg_color": "#000000",
    "bg_opacity": 0.0,
    "stroke_width": 6,
    "position": "CENTER",
    "uppercase": true
  },
  "captions": {
    "mode": "karaoke",
    "word_rate": 0.2,
    "max_words_per_beat": 4
  },
  "layout": {
    "hook": "high_contrast_warning",
    "body": "ambient_natural_sound",
    "payoff": "clean_finish",
    "music_level": "low"
  },
  "sfx_defaults": {
    "EMERGENCY": {
      "text_anim": "highlight",
      "transition_in": "glitch",
      "filter": "pop",
      "sfx": "cinematic_sub_boom"
    },
    "DIAGNOSIS": {
      "text_anim": "clip-reveal",
      "transition_in": "none",
      "filter": "none",
      "sfx": "whoosh_fast"
    },
    "TREATMENT": {
      "text_anim": "word-pop",
      "transition_in": "none",
      "filter": "none",
      "sfx": "tension_riser_medium"
    },
    "RELIEF": {
      "text_anim": "highlight",
      "transition_in": "fade",
      "filter": "sunset",
      "sfx": "bell_ding"
    }
  },
  "allowed_effects_only": {
    "text_anim": [
      "none",
      "highlight",
      "karaoke",
      "wave",
      "bounce",
      "shake",
      "font-cut",
      "word-pop",
      "word-slide",
      "typewriter",
      "letter-pop",
      "clip-reveal",
      "zoom-in",
      "rise-mask"
    ],
    "transitions": [
      "none",
      "fade",
      "slide-left",
      "slide-right",
      "slide-up",
      "slide-down",
      "wipe",
      "wipe-right",
      "wipe-up",
      "wipe-down",
      "zoom",
      "iris",
      "spin",
      "blur",
      "whip",
      "glitch",
      "pop"
    ],
    "filters": [
      "none",
      "cinematic",
      "teal-orange",
      "noir",
      "vintage",
      "faded",
      "warm",
      "cold",
      "pop",
      "dreamy",
      "retro",
      "bw-soft",
      "cyberpunk",
      "sunset",
      "midnight"
    ]
  },
  "rules_for_agent": []
}
